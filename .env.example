# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ or expose to the client.
# Used only inside API routes (src/app/api/attendance/check-in) to validate
# and write attendance rows after independently verifying the user's session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
